expand_icon = true

[node name="Next" type="Button" parent="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer" index="2"]
unique_name_in_owner = true
margin_left = 40.0
margin_right = 56.0
margin_bottom = 16.0
rect_min_size = Vector2( 16, 16 )
theme = ExtResource( 2 )
icon = ExtResource( 6 )
icon_align = 1
expand_icon = true

[connection signal="toggled" from="MusicPlayer/TrayButtonContainer/Tray" to="MusicPlayer" method="_on_Tray_toggled"]
[connection signal="pressed" from="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer/Previous" to="MusicPlayer" method="_on_Previous_pressed"]
[connection signal="toggled" from="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer/Mute" to="MusicPlayer" method="_on_Mute_toggled"]
[connection signal="pressed" from="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer/Next" to="MusicPlayer" method="_on_Next_pressed"]

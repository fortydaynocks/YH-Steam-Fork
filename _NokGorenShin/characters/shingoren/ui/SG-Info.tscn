[gd_scene load_steps=14 format=2]

[ext_resource path="res://characters/PlayerInfo.tscn" type="PackedScene" id=1]
[ext_resource path="res://theme.tres" type="Theme" id=2]
[ext_resource path="res://_NokGorenShin/characters/shingoren/ui/musicplayer/MusicPlayerShinGoren.gd" type="Script" id=3]
[ext_resource path="res://_NokGorenShin/characters/shingoren/ui/musicplayer/musicplayer-previous.png" type="Texture" id=4]
[ext_resource path="res://_NokGorenShin/characters/shingoren/skins/akuma/sounds/sf4-akuma-theme.ogg" type="AudioStream" id=5]
[ext_resource path="res://_NokGorenShin/characters/shingoren/ui/musicplayer/musicplayer-next.png" type="Texture" id=6]
[ext_resource path="res://_NokGorenShin/characters/shingoren/ui/musicplayer/musicplayer-musicON.png" type="Texture" id=7]
[ext_resource path="res://_NokGorenShin/characters/shingoren/ui/musicplayer/musicplayer-traySHOW.png" type="Texture" id=8]
[ext_resource path="res://_NokGorenShin/characters/shingoren/skins/akuma/sounds/sf6-akuma-theme.ogg" type="AudioStream" id=9]
[ext_resource path="res://_NokGorenShin/characters/shingoren/skins/akuma/sounds/sf3-akuma-theme.ogg" type="AudioStream" id=10]
[ext_resource path="res://_NokGorenShin/characters/shingoren/skins/uberoni/sounds/sf4-oni-theme.ogg" type="AudioStream" id=11]
[ext_resource path="res://_NokGorenShin/characters/shingoren/skins/akuma/sounds/sf2-akuma-theme.ogg" type="AudioStream" id=12]

[sub_resource type="GDScript" id=1]
script/source = "extends Node

export (AudioStream) var song
export (String) var song_name
"

[node name="PlayerInfo" instance=ExtResource( 1 )]

[node name="MusicPlayer" type="VBoxContainer" parent="." index="0"]
unique_name_in_owner = true
margin_right = 500.0
margin_bottom = 59.0
mouse_filter = 2
script = ExtResource( 3 )
__meta__ = {
"_editor_description_": ""
}

[node name="MusicAudioPlayer" type="AudioStreamPlayer" parent="MusicPlayer" index="0"]
unique_name_in_owner = true
volume_db = -80.0

[node name="Songs" type="Node" parent="MusicPlayer" index="1"]
unique_name_in_owner = true

[node name="Song4" type="Node" parent="MusicPlayer/Songs" index="0"]
script = SubResource( 1 )
song = ExtResource( 12 )
song_name = "SFII: Akuma"

[node name="Song" type="Node" parent="MusicPlayer/Songs" index="1"]
script = SubResource( 1 )
song = ExtResource( 10 )
song_name = "SF3: Third Strike - Killing Moon"

[node name="Song2" type="Node" parent="MusicPlayer/Songs" index="2"]
script = SubResource( 1 )
song = ExtResource( 5 )
song_name = "SF4: Theme of Akuma"

[node name="Song3" type="Node" parent="MusicPlayer/Songs" index="3"]
script = SubResource( 1 )
song = ExtResource( 9 )
song_name = "SF6: Asura"

[node name="SongsU" type="Node" parent="MusicPlayer" index="2"]
unique_name_in_owner = true

[node name="Song" type="Node" parent="MusicPlayer/SongsU" index="0"]
script = SubResource( 1 )
song = ExtResource( 11 )
song_name = "SF4: Theme of Oni"

[node name="TrayButtonContainer" type="HBoxContainer" parent="MusicPlayer" index="3"]
unique_name_in_owner = true
margin_right = 500.0
margin_bottom = 12.0
mouse_filter = 2

[node name="Tray" type="Button" parent="MusicPlayer/TrayButtonContainer" index="0"]
unique_name_in_owner = true
margin_right = 18.0
margin_bottom = 12.0
rect_min_size = Vector2( 18, 0 )
size_flags_horizontal = 0
theme = ExtResource( 2 )
toggle_mode = true
pressed = true
icon = ExtResource( 8 )
expand_icon = true

[node name="MusicVBoxContainer" type="VBoxContainer" parent="MusicPlayer" index="4"]
unique_name_in_owner = true
margin_top = 16.0
margin_right = 500.0
margin_bottom = 59.0
mouse_filter = 2
custom_constants/separation = 2

[node name="Title" type="Label" parent="MusicPlayer/MusicVBoxContainer" index="0"]
unique_name_in_owner = true
margin_right = 500.0
margin_bottom = 11.0
theme = ExtResource( 2 )
text = "Music Control"

[node name="SongNameContainer" type="HBoxContainer" parent="MusicPlayer/MusicVBoxContainer" index="1"]
unique_name_in_owner = true
margin_top = 13.0
margin_right = 500.0
margin_bottom = 25.0

[node name="SongName" type="Button" parent="MusicPlayer/MusicVBoxContainer/SongNameContainer" index="0"]
unique_name_in_owner = true
margin_right = 134.0
margin_bottom = 12.0
size_flags_horizontal = 0
theme = ExtResource( 2 )
button_mask = 0
text = "No song currently playing..."

[node name="MusicPlayerContainer" type="HBoxContainer" parent="MusicPlayer/MusicVBoxContainer" index="2"]
unique_name_in_owner = true
margin_top = 27.0
margin_right = 500.0
margin_bottom = 43.0
mouse_filter = 2

[node name="Previous" type="Button" parent="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer" index="0"]
unique_name_in_owner = true
margin_right = 16.0
margin_bottom = 16.0
rect_min_size = Vector2( 16, 16 )
theme = ExtResource( 2 )
icon = ExtResource( 4 )
icon_align = 1
expand_icon = true

[node name="Mute" type="Button" parent="MusicPlayer/MusicVBoxContainer/MusicPlayerContainer" index="1"]
unique_name_in_owner = true
margin_left = 20.0
margin_right = 36.0
margin_bottom = 16.0
rect_min_size = Vector2( 16, 16 )

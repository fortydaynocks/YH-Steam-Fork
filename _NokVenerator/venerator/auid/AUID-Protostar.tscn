script/source = "extends ActionUIData

func on_button_selected():
	.on_button_selected()
	
	$\"%Flash\".disabled = true
	
	if self.fighter:
		if self.fighter.supers_available >= 1:
			$\"%Flash\".disabled = false


func _on_Flash_pressed():
	self.emit_signal(\"data_changed\")
"


[sub_resource type="GDScript" id=1]
script/source = "extends ActionUIData

onready var mod = $\"%Adjust\"
var last_mod = false

func _process(d):
	var new_mod = mod.get_data()
	
	if new_mod != last_mod:
		emit_signal(\"data_changed\")
		
	last_mod = new_mod
"

[sub_resource type="GDScript" id=2]

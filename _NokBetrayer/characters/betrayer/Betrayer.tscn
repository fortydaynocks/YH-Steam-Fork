[sub_resource type="GDScript" id=1]
script/source = "extends ObjectState

func _tick():
	._tick()
	
	var pos = host.get_pos()
	var vel = Vector2(int(host.get_vel().x), int(host.get_vel().y))
	host.sprite.rotation_degrees = rad2deg(vel.angle())
	
	self.apply_forces = current_tick < 12
	
	if (current_tick >= 3 and current_tick < 11) and (host.is_grounded() == true or host.get_pos().x == host.stage_width):
		current_tick = 11

	if current_tick == 11:
		host.creator.spawn_particle_effect(host.creator.vfx_table.Hit2, Vector2(pos.x, pos.y))

func _frame_15():
	host.disable()
"


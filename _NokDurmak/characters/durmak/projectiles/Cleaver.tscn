[sub_resource type="GDScript" id=4]
script/source = "extends \"res://_NokDurmak/characters/durmak/projectiles/DM-Projectile.gd\"

var lodge = false
var deflected = false

func tick():
	.tick()
	
	var pos = self.get_pos()
	var opos = self.get_opponent().get_pos()
	
	if self.current_state().state_name == \"Recoil\":
		for hbox in self.creator.get_active_hitboxes():
			if hbox.overlaps(self.hurtbox):
				hbox.deactivate()
				
				self.creator.projectile_free_cancel()
				self.spawn_particle_effect_relative(preload(\"res://_NokDurmak/characters/durmak/effects/DM-Hit0.tscn\"), Vector2(0, 0))
				
				self.global_hitlag(6)
				self.rumble(1, 6)
				
				self.play_sound(\"Deflect\")
				self.play_sound(\"Deflect2\")
				
				self.change_state(\"Default\")
				var vec = Vector2(opos.x - pos.x, (opos.y - 18) - pos.y).normalized()
				self.set_vel(str(20 * vec.x), str(20 * vec.y))
				
				lodge = true
				deflected = true
"

